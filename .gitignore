# ---- build output ----------------------------------------------------------
/target
/ui/node_modules
/ui/dist
/ui/*.tsbuildinfo
# Regenerated by tauri-build on every build.
/src-tauri/gen

# ---- run output ------------------------------------------------------------
# `dist/.stage/output` holds the runs of `run_all.sh`. Kept: the scripts, the error
# summary, and per body the reconstruction (`history.json`) and the two scenario
# start snapshots that the desktop bundle and the web page ship. Everything else
# (logs, checkpoints, step logs, OBJ dumps, forward/future runs) is rebuilt by
# `run_all.sh`.
/dist/.stage/output/*
!/dist/.stage/output/run_all.sh
!/dist/.stage/output/evaluate.py
!/dist/.stage/output/evaluation.json
!/dist/.stage/output/*/
/dist/.stage/output/*/*
!/dist/.stage/output/*/inspect_forward.json
!/dist/.stage/output/*/history/
/dist/.stage/output/*/history/*
!/dist/.stage/output/*/history/history.json
!/dist/.stage/output/*/history/initial.json
!/dist/.stage/output/*/history/present.json

# ---- local tools -----------------------------------------------------------
.DS_Store
.codexignore
.idea/
.vscode/
*.swp
